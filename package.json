{
  "name": "-",
  "private": true,
  "version": "0.0.0",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder",
    "rebuild": "electron-rebuild -f -w serialport",
    "electron:run-build": "npm run build && pnpm exec electron-rebuild && electron-builder"
  },
  "build": {
    "appId": "com.yourcompany.pressuremonitor",
    "productName": "压力监控系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "server.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asar": false,
    "asarUnpack": [
      "**/node_modules/serialport/**",
      "**/node_modules/@serialport/**"
    ]
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "axios": "^1.21.0",
    "chart.js": "^4.6.1",
    "echarts": "^6.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "modbus-serial": "^8.0.25",
    "qrcode": "^1.5.4",
    "serialport": "^13.0.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "naive-ui": "^2.45.3",
    "sass": "^1.108.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5"
  }
}
